{
  "name": "gameforgejs",
  "version": "1.0.0",
  "private": true,
  "description": "Modular JavaScript game runtime and project tooling for the browser",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gameforge": "./cli/index.cjs"
  },
  "exports": {
    ".": "./src/core/index.js",
    "./core": "./src/core/index.js",
    "./2d": "./src/2d/index.js",
    "./3d": "./src/3d/index.js",
    "./network": "./src/network/index.js",
    "./compat": "./src/compat/index.js",
    "./addons/parallax": "./src/addons/parallax/index.js",
    "./addons/state-machine": "./src/addons/state-machine/index.js",
    "./addons/platformer": "./src/addons/platformer/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cli",
    "README.md"
  ],
  "scripts": {
    "start": "node cli/index.cjs serve",
    "dev": "node cli/index.cjs serve",
    "check": "node scripts/check-js.js && node scripts/check-imports.js && node scripts/check-editor-assets.js && node scripts/check-projects.cjs && node scripts/check-runtime.js",
    "check:editor-assets": "node scripts/check-editor-assets.js",
    "docs": "node scripts/generate-docs.js",
    "docs:check": "node scripts/generate-docs.js --check",
    "docs:serve": "node cli/index.cjs serve --root docs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:site": "node tests/site-browser.cjs",
    "build": "node cli/index.cjs build --root examples/platform-adventure-2d --out ../../dist/platform-adventure-2d",
    "publish": "node cli/index.cjs build --root examples/platform-adventure-2d --out ../../dist/platform-adventure-2d",
    "test:sky-trail": "node tests/sky-trail-browser.cjs",
    "test:touch": "node tests/touch-browser.cjs",
    "capture:examples": "node scripts/capture-examples.cjs",
    "test:fighting": "node tests/fighting-browser.cjs",
    "server:online": "dotnet run --project servers/online-sandbox --urls http://127.0.0.1:8080",
    "dev:online": "node cli/index.cjs serve --root . --port 3000",
    "test:online": "dotnet build tests/online-motion --nologo && node tests/online-browser.cjs",
    "typecheck:foundry": "tsc -p examples/storm-foundry-2d/config/tsconfig.json",
    "test:foundry": "npm run typecheck:foundry && node tests/foundry-browser.cjs",
    "test:lessons": "node tests/lessons-browser.cjs",
    "check:pages": "node scripts/check-pages.cjs"
  },
  "dependencies": {
    "acorn": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "5.9.3"
  }
}
