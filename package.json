{
  "name": "gameforgejs",
  "version": "1.0.0",
  "description": "Zero-dependency 2D and 3D ECS runtime for the browser",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./types/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./core": {
      "types": "./types/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./2d": {
      "types": "./types/2d/index.d.ts",
      "default": "./src/2d/index.js"
    },
    "./3d": {
      "types": "./types/3d/index.d.ts",
      "default": "./src/3d/index.js"
    },
    "./network": {
      "types": "./types/network/index.d.ts",
      "default": "./src/network/index.js"
    },
    "./compat": {
      "types": "./types/compat/index.d.ts",
      "default": "./src/compat/index.js"
    },
    "./addons/parallax": {
      "types": "./types/addons/parallax/index.d.ts",
      "default": "./src/addons/parallax/index.js"
    },
    "./addons/state-machine": {
      "types": "./types/addons/state-machine/index.d.ts",
      "default": "./src/addons/state-machine/index.js"
    },
    "./addons/platformer": {
      "types": "./types/addons/platformer/index.d.ts",
      "default": "./src/addons/platformer/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md"
  ]
}
