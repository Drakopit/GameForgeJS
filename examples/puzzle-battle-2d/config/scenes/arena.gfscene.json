      "transform": {
        "position": [50, 100]
      },
      "size": [192, 384]
    },
    {
      "id": "board_2",
      "name": "CPU board",
      "type": "Area2D",
      "layer": "boards",
      "scripts": ["src/entities/PuzzleBoard.js"],
      "transform": {
        "position": [550, 100]
      },
      "size": [192, 384]
    }
  ]
