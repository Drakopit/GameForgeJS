{
  "schemaVersion": 1,
  "window": {
    "title": "GameForgeJS \u00e2\u20ac\u201d Puzzle Battle 2D",
    "backgroundColor": "#1a1a1a"
  },
  "screen": {
    "width": 800,
    "height": 600,
    "fullScreen": false,
    "pixelArt": true
  },
  "physics": {
    "enabled": false
  },
  "project": {
    "name": "Puzzle Battle 2D"
  },
  "input": {
    "actionMappings": {
      "PUZZLE_LEFT": [
        {
          "device": "keyboard",
          "input": "KeyA"
        },
        {
          "device": "gamepad",
          "input": "DPAD_LEFT"
        }
      ],
      "PUZZLE_RIGHT": [
        {
          "device": "keyboard",
          "input": "KeyD"
        },
        {
          "device": "gamepad",
          "input": "DPAD_RIGHT"
        }
      ],
      "PUZZLE_ROTATE": [
        {
          "device": "keyboard",
          "input": "KeyW"
        },
        {
          "device": "gamepad",
          "input": "button_0"
        }
      ],
      "PUZZLE_DROP": [
        {
          "device": "keyboard",
          "input": "KeyS"
        },
        {
          "device": "gamepad",
          "input": "DPAD_DOWN"
        }
      ],
      "RESET": [
        {
          "device": "keyboard",
          "input": "KeyR"
        },
        {
          "device": "gamepad",
          "input": "button_3"
        }
      ]
    }
  }
}
